package com.surgex.app.auth

import com.google.firebase.auth.FirebaseAuth
import com.google.firebase.auth.FirebaseUser
import com.google.firebase.firestore.FirebaseFirestore
import kotlinx.coroutines.tasks.await

enum class UserRole {
    RIDER,
    DRIVER
}

enum class AccountStatus {
    PENDING_APPROVAL,
    APPROVED,
    SUSPENDED,
    REJECTED
}

sealed class AuthResult {
    data object Success : AuthResult()
    data class Error(val message: String) : AuthResult()
    data object PendingApproval : AuthResult()
}

class AuthController {

    private val auth = FirebaseAuth.getInstance()
    private val db = FirebaseFirestore.getInstance()

    val currentUser: FirebaseUser?
        get() = auth.currentUser

    val isLoggedIn: Boolean
        get() = auth.currentUser != null

    suspend fun register(
        name: String,
        email: String,
        phone: String,
        password: String,
        role: UserRole
    ): AuthResult {

        return try {

            val result = auth
                .createUserWithEmailAndPassword(
                    email.trim(),
                    password
                )
                .await()

            val uid = result.user?.uid
                ?: return AuthResult.Error("Registration failed.")

            val userData = hashMapOf(
                "uid" to uid,
                "name" to name.trim(),
                "email" to email.trim(),
                "phone" to phone.trim(),
                "role" to role.name,
                "status" to AccountStatus.PENDING_APPROVAL.name,
                "createdAt" to System.currentTimeMillis()
            )

            db.collection("users")
                .document(uid)
                .set(userData)
                .await()

            // Do NOT keep a newly registered user logged in.
            auth.signOut()

            AuthResult.PendingApproval

        } catch (e: Exception) {

            AuthResult.Error(
                e.message ?: "Registration failed."
            )
        }
    }

    suspend fun login(
        email: String,
        password: String
    ): AuthResult {

        return try {

            auth.signInWithEmailAndPassword(
                email.trim(),
                password
            ).await()

            val user = auth.currentUser
                ?: return AuthResult.Error("Unable to sign in.")

            val snapshot = db
                .collection("users")
                .document(user.uid)
                .get()
                .await()

            if (!snapshot.exists()) {
                auth.signOut()

                return AuthResult.Error(
                    "Your account profile could not be found."
                )
            }

            val status = snapshot
                .getString("status")
                ?: AccountStatus.PENDING_APPROVAL.name

            when (status) {

                AccountStatus.APPROVED.name -> {
                    AuthResult.Success
                }

                AccountStatus.PENDING_APPROVAL.name -> {
                    auth.signOut()
                    AuthResult.PendingApproval
                }

                AccountStatus.SUSPENDED.name -> {
                    auth.signOut()
                    AuthResult.Error(
                        "Your SurgeX account is suspended."
                    )
                }

                AccountStatus.REJECTED.name -> {
                    auth.signOut()
                    AuthResult.Error(
                        "Your SurgeX account was not approved."
                    )
                }

                else -> {
                    auth.signOut()
                    AuthResult.Error(
                        "Your account status is invalid."
                    )
                }
            }

        } catch (e: Exception) {

            AuthResult.Error(
                e.message ?: "Login failed."
            )
        }
    }

    suspend fun getUserRole(): UserRole? {

        val user = auth.currentUser ?: return null

        return try {

            val snapshot = db
                .collection("users")
                .document(user.uid)
                .get()
                .await()

            when (
                snapshot.getString("role")
            ) {
                UserRole.DRIVER.name -> UserRole.DRIVER
                UserRole.RIDER.name -> UserRole.RIDER
                else -> null
            }

        } catch (_: Exception) {
            null
        }
    }

    fun logout() {
        auth.signOut()
    }
}
